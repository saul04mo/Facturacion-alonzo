# Puerto donde escucha el servicio (Cloud Run inyecta este valor automáticamente)
PORT=8080

# URL del endpoint de token OAuth de Banesco (QA)
BANESCO_SSO_URL=https://sso-sso-project.apps.desplakur3.desintra.banesco.com/auth/realms/realm-api-qa/protocol/openid-connect/token

# URL del endpoint de consulta de transacciones (QA)
BANESCO_API_URL=https://sid-validador-consulta-de-transacciones-api-qa-production.apps.desplakur3.desintra.banesco.com/transactions/financial-account/transactions

# Credenciales del cliente OAuth (se envían como Basic Auth: client_id:client_secret)
BANESCO_CLIENT_ID=tu-client-id
BANESCO_CLIENT_SECRET=tu-client-secret

# Credenciales de usuario (grant_type=password)
BANESCO_USERNAME=tu-usuario
BANESCO_PASSWORD=tu-password

# Cuenta sobre la que se consultan las transacciones por rango de fechas
BANESCO_ACCOUNT_ID=tu-account-id
